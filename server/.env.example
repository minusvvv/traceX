# --- Server environment (copy to server/.env). Never commit the real .env. ---
NODE_ENV=development
PORT=5000
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGIN=http://localhost:5173
# Demo accounts are seeded on first start when the database is empty and SEED_ON_EMPTY=true (default outside production).
# All demo accounts share this password. Leave empty to have a random one generated and printed once.
DEMO_PASSWORD=
SEED_ON_EMPTY=true
# Production first-admin bootstrap (used only when there are no users and SEED_ON_EMPTY=false)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Storage
DB_PATH=
UPLOAD_DIR=
# HTTPS (set both behind a TLS-terminating proxy in production)
FORCE_HTTPS=false
COOKIE_SECURE=
# Integrations: only "mock" adapters exist. They are labelled as simulated everywhere.
SUPPLY_CHAIN_PROVIDER=mock
FSSAI_ADAPTER=mock
MOCK_SUPPLY_CHAIN_MODE=ok    # ok | unavailable | partial
MOCK_FSSAI_MODE=ok           # ok | fail | flaky
ALLOW_SIMULATION=true        # lets reviewers trigger mock failures per request; keep false in production
# Prioritisation defaults (administrators change these in the app)
DEFAULT_THRESHOLD_COUNT=3
DEFAULT_THRESHOLD_WINDOW_DAYS=30
# Public heat-map privacy
PUBLIC_MAP_CELL_DEG=0.1
PUBLIC_MAP_MIN_CELL=3
RATE_LIMIT=true
