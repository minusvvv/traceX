# Optional. Leave unset in development: requests go to /api and Vite proxies them to the Express server.
# Production uses the same-origin /api rewrite; leave VITE_API_URL unset.
# A separate browser API origin also requires compatible cookie SameSite settings.
# VITE_API_URL=http://localhost:5000/api
# Used locally by npm run configure:vercel BEFORE deployment; not a browser variable.
# BACKEND_ORIGIN=https://your-persistent-api-host.example
